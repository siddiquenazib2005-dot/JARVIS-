# AURIX backend configuration
# Copy to .env (or paste into your host's environment settings) and fill in
# whatever keys you actually have. At least one is required.
#
# Auth: /v1/* requires Authorization: Bearer <AURIX_APP_TOKEN> when set.
# If AURIX_APP_TOKEN is unset, the server refuses /v1/* with 503 unless
# AURIX_ALLOW_ANON=true (localhost only — never on a public host).

# --- Required for public deploys: app must send this as Bearer token ---
AURIX_APP_TOKEN=

# --- Local only: open /v1 without a token (do NOT set on Render/prod) ---
# AURIX_ALLOW_ANON=true

# --- LLM provider keys (any subset; routing adapts automatically) ---
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Optional extra keys for quota pooling on the same provider ---
# GROQ_API_KEY_2=
# GEMINI_API_KEY_2=

# --- Runtime ---
PORT=8080
AURIX_DATA_DIR=./data
